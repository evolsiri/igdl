{
  "name": "igdl",
  "private": true,
  "version": "3.1.0",
  "description": "Instagram / Threads media downloader extension for Chrome and Firefox.",
  "license": "MIT",
  "author": "evolsiri",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:chrome": "TARGET=chrome node scripts/build.mjs --watch",
    "dev:firefox": "pnpm exec web-ext run --source-dir=dist/firefox",
    "dev:firefox:win": "node scripts/watch-firefox-win.mjs",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "tsc -b && TARGET=chrome node scripts/build.mjs",
    "build:firefox": "tsc -b && TARGET=firefox node scripts/build.mjs",
    "package:chrome": "TARGET=chrome node scripts/package.mjs",
    "package:firefox": "TARGET=firefox node scripts/package.mjs",
    "sign:firefox": "node scripts/sign-firefox.mjs",
    "rc:firefox": "node scripts/rc-firefox.mjs",
    "preview": "vite preview",
    "lint": "eslint --cache --fix .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:storybook": "STORYBOOK_TESTS=1 vitest run --project storybook",
    "check:stories": "node scripts/check-stories-coverage.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=chpt_04170d658051151",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "dayjs": "^1.11.20",
    "fflate": "^0.8.2",
    "preact": "^10.29.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/preact-vite": "^10.3.6",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.1.40",
    "@types/node": "^24.12.2",
    "@vitest/browser-playwright": "4.1.4",
    "@vitest/coverage-v8": "4.1.4",
    "chromatic": "^16.3.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.3.6",
    "globals": "^17.5.0",
    "@zip.js/zip.js": "^2.8.26",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "storybook": "^10.3.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4",
    "web-ext": "^10.1.0"
  }
}
