{
  "manifest_version": 3,
  "name": "igdl",
  "version": "1.0.10",
  "description": "Instagram and Threads media downloader with per-profile download directories.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.threads.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.threads.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "igdl"
  },
  "options_page": "options.html",
  "externally_connectable": {
    "matches": [
      "*://*.threads.com/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://www.threads.com/*"
      ]
    }
  ]
}
