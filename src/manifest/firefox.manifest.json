{
  "manifest_version": 3,
  "name": "igdl",
  "version": "3.1.1",
  "description": "Instagram and Threads media downloader with per-profile download directories.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.threads.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.threads.com/*"
      ],
      "js": [
        "content.js",
        "loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "logo.svg",
    "32": "logo.svg",
    "48": "logo.svg",
    "128": "logo.svg"
  },
  "action": {
    "default_title": "igdl",
    "default_icon": "logo.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://www.threads.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "igdl@evolsiri.local",
      "strict_min_version": "115.0"
    }
  }
}
